{
  "name": "orthobox",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Client-side PWA gathering short games for speech therapy sessions",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-icons.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "icons": "node scripts/generate-icons.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
